<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>

    <div class="container mt-5 text-center">
        <h1>Teachers Management</h1>
        <a href="/teacher/create" class="btn btn-info">Add Teachers</a> ||
        <a href="/teacher/recycle-bin" class="btn btn-warning">Recycle Bin</a>

        <table class="table table-striped-columns mt-3">
            <thead>
                <tr>
                    <th scope="col">Sl.No</th>
                    <th scope="col">Teacher-Id</th>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Phone</th>
                    <th scope="col">Address</th>
                    <th scope="col">Salary</th>
                    <th scope="col">Experience</th>
                    <th scope="col">Subject</th>
                    <th scope="col">Department</th>
                    <th scope="col">Gender</th>
                    <th scope="col">Image</th>
                    <th scope="col">Status</th>
                    <th scope="col" colspan="3">Action</th>
                </tr>
            </thead>
            <tbody>

                <% if (teachers && teachers.length> 0) { %>

                    <% teachers.forEach((item, index)=> { %>

                        <tr>
                            <td>
                                <%= index + 1 %>
                            </td>
                            <td>
                                <%= item._id.toString().slice(-5) %>
                            </td>
                            <td>
                                <%= item.Name %>
                            </td>
                            <td>
                                <%= item.Email %>
                            </td>
                            <td>
                                <%= item.Phone %>
                            </td>
                            <td>
                                <%= item.Address %>
                            </td>
                            <td>
                                <%= item.Salary %>
                            </td>
                            <td>
                                <%= item.Experience %>
                            </td>
                            <td>
                                <%= item.Subject %>
                            </td>
                            <td>
                                <%= item.Department %>
                            </td>
                            <td>
                                <%= item.Gender %>
                            </td>
                            <td>
                                <% if (item.image && item.image.startsWith("http")) { %> 
                                    <!-- Default / Online Image -->
                                    <img src="<%= item.image %>" alt="<%= item.Name %>" width="50" height="50"
                                        style="object-fit: cover; border-radius: 5px;">
                                    <% } else if (item.image) { %>
                                        <!-- Uploaded Local Image --> <img src="/uploads/<%= item.image %>"
                                            alt="<%= item.Name %>" width="50" height="50"
                                            style="object-fit: cover; border-radius: 5px;">
                                        <% } else { %> No Image <% } %>
                            </td>
                            <td>
                                <%= item.Status %>
                            </td>

                            <td>
                                <!-- View --> <a href="/teacher/view/<%= item._id %>" class="btn btn-primary btn-sm">
                                    View
                                </a>
                            </td>
                            <td>
                                <!-- Edit --> <a href="/teacher/edit/<%= item._id %>" class="btn btn-warning btn-sm">
                                    Edit
                                </a>
                            </td>
                            <td>
                                <!-- Delete --> <a href="/teacher/delete/<%= item._id %>" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Are you sure you want to delete this teacher?')">
                                    Delete
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="14" class="text-center"> No Teachers Found </td>
                                </tr>
                                <% } %>
            </tbody>
        </table>

    </div>




    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>